# ===== من Discord Developer Portal =====
# Bot > Reset Token
DISCORD_TOKEN=ضع_توكن_البوت_هنا

# General Information > Application ID
CLIENT_ID=ضع_client_id_هنا

# OAuth2 > General > Client Secret
CLIENT_SECRET=ضع_client_secret_هنا

# OAuth2 > Redirects (لازم يطابق تماماً رابط موقعك بعد النشر)
CALLBACK_URL=https://your-app.up.railway.app/auth/discord/callback

# ===== من MongoDB Atlas (حساب خارجي - mongodb.com/cloud/atlas) =====
# Atlas: Connect > Drivers، وانسخ رابط الاتصال كامل
# استبدل <username> و<password> بيوزر وباسورد قاعدة البيانات اللي سويتها
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/discord_bot?retryWrites=true&w=majority

# اسم قاعدة البيانات (اختياري) - لو ما حطيته يستخدم "discord_bot" افتراضيًا
MONGODB_DB_NAME=discord_bot

# ===== أنظمة الحماية المتقدمة (اختياري) =====
# لو ما حطيته، فحص VirusTotal (بالروابط والملفات) بس يتخطى نفسه بصمت، وباقي الأنظمة تشتغل عادي
# مجاني من virustotal.com/gui/join-us - Profile > API Key
VIRUSTOTAL_API_KEY=ضع_مفتاح_virustotal_هنا

# ===== نظام الموسيقى (اختياري - يحتاج سيرفر لافا لينك منفصل) =====
# انشر مجلد lavalink/ كخدمة ثانية على Railway (يستخدم نفس Dockerfile الموجود بالمجلد)
LAVALINK_HOST=ضع_دومين_خدمة_لافا_لينك_هنا
LAVALINK_PORT=2333
LAVALINK_PASSWORD=غيّر_هذا_لكلمة_سر_قوية_ونفس_القيمة_بخدمة_لافا_لينك
LAVALINK_SECURE=false

# ===== نظام السينما (اختياري) =====
# مجاني من themoviedb.org/settings/api
TMDB_API_KEY=ضع_مفتاح_tmdb_هنا

# ===== تسويها أنت =====
# نص عشوائي طويل لتشفير الجلسات - ولده من randomkeygen.com
SESSION_SECRET=غيّر_هذا_النص_لشي_عشوائي_وطويل

# Railway يحدده تلقائي، ما تحتاج تغيره
PORT=3000
